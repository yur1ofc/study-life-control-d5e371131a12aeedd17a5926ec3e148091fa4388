# Este arquivo existe para que o Vercel PARE de usar o .gitignore
# como filtro do que enviar no deploy (comportamento padrão do
# Vercel CLI quando não há .vercelignore).
#
# Sem este arquivo, o env-config.js (gerado durante o build por
# inject-env.js) era descartado no deploy porque está listado no
# .gitignore — mesmo tendo sido criado com sucesso no build.
#
# NÃO adicione env-config.js aqui.

node_modules/
.git/
.vercel/
*.log
.DS_Store

# Documentacao interna e arquivos que nao precisam ser publicos.
# NAO remova inject-env.js, package.json, env-config.js, robots.txt
# nem sitemap.xml: o build e o site dependem deles.
/*.md
/README.txt
/LEIA-ME.txt
/CHATGPT-GRADE-PROMPT.txt
/SLCampus_contexto_atual_completo_para_outra_IA.txt
/firestore.rules
/storage.rules
/firebase.json
/.firebaserc
/gemini.js
/ai-core.js
/gemini-admin-quota.js
/scripts/
